      "item": [
        {
          "name": "Create Course",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"New Course Title\",\n  \"description\": \"A concise description of what students will learn in this course.\",\n  \"instructorName\": \"Instructor Name\",\n  \"price\": 4999,\n  \"category\": \"Web Development\",\n  \"tags\": [\n    \"React\",\n    \"Node.js\",\n    \"MongoDB\"\n  ],\n  \"syllabus\": [\n    {\n      \"title\": \"Module 1: Getting Started\",\n      \"lessons\": [\n        {\n          \"title\": \"Lesson 1: Introduction\",\n          \"videoUrl\": \"https://www.youtube.com/embed/dQw4w9WgXcQ\",\n          \"liveClassLink\": \"https://meet.google.com/abc-defg-hij\",\n          \"liveClassDate\": \"2026-01-15T18:00:00.000Z\",\n          \"assignmentPrompt\": \"Build a small project and submit the repository link.\",\n          \"quiz\": [\n            {\n              \"question\": \"Which hook is used for side effects in React?\",\n              \"options\": [\n                \"useState\",\n                \"useMemo\",\n                \"useEffect\",\n                \"useCallback\"\n              ],\n              \"correctIndex\": 2\n            },\n            {\n              \"question\": \"Which command installs dependencies from package.json?\",\n              \"options\": [\n                \"npm start\",\n                \"npm install\",\n                \"npm run build\",\n                \"npm test\"\n              ],\n              \"correctIndex\": 1\n            }\n          ]\n        },\n        {\n          \"title\": \"Lesson 2: Hands-on Project\",\n          \"videoUrl\": \"https://www.youtube.com/embed/dQw4w9WgXcQ\",\n          \"assignmentPrompt\": \"Implement the project described in the lesson.\"\n        }\n      ]\n    }\n  ],\n  \"batches\": [\n    {\n      \"name\": \"Batch 1 (Spring 2026)\",\n      \"startDate\": \"2026-01-10T00:00:00.000Z\"\n    },\n    {\n      \"name\": \"Batch 2 (Summer 2026)\",\n      \"startDate\": \"2026-06-01T00:00:00.000Z\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/courses",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "courses"
              ]
            },
            "description": "Creates a course with modules, lessons, quizzes, and batches.\n\nAuth: Bearer {{adminToken}} (admin role required).\n\nTest script saves the new course id to {{courseId}}, the first lesson id to {{lessonId}}, and the first batch id to {{batchId}}.",
