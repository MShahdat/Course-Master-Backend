      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john.doe@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"student\",\n  \"adminKey\": \"\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "Creates a user account. By default the role is student.\n\nTo create an admin, set \"role\": \"admin\" and provide an adminKey matching ADMIN_REGISTRATION_KEY. If the key is invalid, the account is created as a student.\n\nAuth: none.\n\nTest script saves the returned token to {{token}} and the user id to {{userId}}.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.token) {",
                  "    pm.collectionVariables.set(\"token\", body.token);",
                  "}",
                  "if (body.user && body.user.id) {",
                  "    pm.collectionVariables.set(\"userId\", body.user.id);",
                  "}",
                  "if (body.user && body.user.role === \"admin\" && body.token) {",
                  "    pm.collectionVariables.set(\"adminToken\", body.token);",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
