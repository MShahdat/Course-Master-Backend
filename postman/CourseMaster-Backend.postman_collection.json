              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body._id) {",
                  "    pm.collectionVariables.set(\"courseId\", body._id);",
                  "}",
                  "const firstModule = body.syllabus && body.syllabus[0];",
                  "const firstLesson = firstModule && firstModule.lessons && firstModule.lessons[0];",
                  "if (firstLesson && firstLesson._id) {",
                  "    pm.collectionVariables.set(\"lessonId\", firstLesson._id);",
                  "}",
                  "const firstBatch = body.batches && body.batches[0];",
                  "if (firstBatch && firstBatch._id) {",
                  "    pm.collectionVariables.set(\"batchId\", firstBatch._id);",
                  "}"
                ]
              }
